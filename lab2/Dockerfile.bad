# Плохой Dockerfile
# Содержит bad practices из задания

# Bad practice 1: полноценный ubuntu вместо python:3.12-slim
# Образ тянет лишние системные пакеты и весит в разы больше нужного.
# Не указывается точная версия.
FROM ubuntu:latest

# Ставим Python и тд - всё с нуля, потому что в ubuntu изначально ничего нет.
# Отсутствие чистки apt-кеша раздувает образ.
RUN apt-get update && apt-get install -y \
        python3 \
        python3-pip \
        postgresql-client \
        libpq-dev \
        gcc

# Bad practice 2: COPY . . в самом начале
# Копирует проект целиком, включая то, что для контейнера не нужно.
COPY . .

# Устанавливаем зависимости после COPY.
# Любая правка любого файла заставляет контейнер загружать все с самого начала, а это долго.
RUN pip3 install --break-system-packages -r backend/requirements.txt

WORKDIR /backend

# Bad practice 3: запуск от root
# Пользователь не создаётся: USER не указан.
# Приложение работает с полными правами внутри контейнера.

# Bad practice 4: нет HEALTHCHECK
#Docker по умолчанию следит за тем, чтобы только главный процесс не завершился
# Если Flask зависнет, контейнер продолжит считаться работающим.

EXPOSE 5000

#Docker пошлёт сигнал завершения,
#а Пайтон не успеет корректно закрыть соединение с базой данных.
CMD python3 app.py